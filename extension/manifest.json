{
  "manifest_version": 3,
  "name": "PDF-читалка",
  "version": "0.2.0",
  "description": "Чтение PDF с автопрокруткой, озвучкой и перемоткой по экрану",
  "browser_specific_settings": {
    "gecko": {
      "id": "pdf-reader@chadgpttop666.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "action": {
    "default_title": "Открыть PDF-читалку",
    "default_icon": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "webRequest",
    "webRequestBlocking",
    "contextMenus",
    "tabs"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
